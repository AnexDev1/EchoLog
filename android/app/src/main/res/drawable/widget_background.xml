<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#F0F0F0" /> <!-- A light grey color, change as needed -->

    <!-- Rounded corners -->
    <corners android:radius="12dp" /> <!-- Adjust radius as desired -->

    <!-- Optional: Add a border -->
    <!--
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />
    -->

    <!-- Optional: Add padding if you want the content to be inset from the background shape -->
    <!-- Note: Padding here is different from padding on the LinearLayout itself.
         This padding is part of the drawable.
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />
    -->
</shape>